VITE_USE_MOCK_SERVICES=true

VITE_CHAT_API_URL=
VITE_AVAILABILITY_API_URL=

# Tapis tenant base URL. Execution systems and their batch queues are
# always read from here (never mocked) — set it to your tenant if it is
# not the ICICLE one.
VITE_TAPIS_API_URL=https://icicle.tapis.io

# Name of the cookie holding the Tapis JWT. Only set this if your
# portal uses a different name; the token is read from it and sent as
# the X-Tapis-Token header on every API call.
VITE_TAPIS_TOKEN_COOKIE=X-Tapis-Token

# LOCAL DEVELOPMENT ONLY — a Tapis JWT to use when no cookie is present.
#
# The portal sets the real cookie on its own domain, so a dev server on
# localhost never receives one: every Tapis call (systems, queues,
# userinfo) returns 401 and the Explore Lake identity falls back to a
# stand-in persona. Paste a token here to develop against a real
# session.
#
#   Get one with:  tapis auth tokens short-lived
#   or copy the X-Tapis-Token cookie value from a signed-in portal tab.
#
# VITE_* values are inlined into the bundle at build time, so a token
# set here ships to everyone who loads the app. Never set it in a
# deployed build.
# VITE_TAPIS_TOKEN=

# Slurm allocation charged for batch jobs, sent as the
# "slurm account" scheduler option (-A <account>).
VITE_SLURM_ACCOUNT=PAS2699

# Geo Harmonizer lake query API (harvest-iceberg-datalake) — the
# read-only service behind the "Explore Lake" view. Needs an
# SSH/kubectl port-forward to the Iceberg catalog to serve anything,
# and its own AWS credentials to read S3 (backend concern, not this
# app's). Every endpoint in the contract is implemented server-side —
# VITE_USE_MOCK_SERVICES=false talks to the real thing.
VITE_LAKE_API_URL=http://localhost:8000
