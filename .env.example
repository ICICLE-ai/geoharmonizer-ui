VITE_USE_MOCK_SERVICES=true

VITE_CHAT_API_URL=
VITE_AVAILABILITY_API_URL=

# Tapis tenant base URL. Execution systems and their batch queues are
# always read from here (never mocked) — set it to your tenant if it is
# not the ICICLE one.
VITE_TAPIS_API_URL=https://icicle.tapis.io

# Name of the cookie holding the Tapis JWT. Only set this if your
# portal uses a different name; the token is read from it and sent as
# the X-Tapis-Token header on every API call.
VITE_TAPIS_TOKEN_COOKIE=X-Tapis-Token
