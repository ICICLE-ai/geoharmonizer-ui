# Rendered at container start by the nginx image's envsubst hook, so the
# listen port can be changed without rebuilding: `-e PORT=8080`.
#
# The default is 5000 because that is the port Tapis Pods route to.

server {
    listen       ${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Single-page app: unknown paths fall back to index.html rather
    # than 404, so a refresh on a deep link still loads the app.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed build assets are immutable; index.html must never be
    # cached or users keep running the previous deploy.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    gzip              on;
    gzip_types        text/css application/javascript application/json image/svg+xml;
    gzip_min_length   1024;
}
